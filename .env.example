# ========================================
# Oncall Opinion Analyse 配置文件
# ========================================
# 复制此文件为 .env 并填写实际值

# ========================================
# 环境设置
# ========================================
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ========================================
# LLM API 配置 (必填)
# ========================================
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# DeepSeek（OpenAI-compatible API）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=                    # 可选，自定义 API 地址
OPENAI_MODEL=gpt-4o

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ========================================
# ClickHouse 数据库配置 (必填)
# ========================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=network_telemetry
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_PROTOCOL=https
CLICKHOUSE_SECURE=true

# ========================================
# Qdrant 向量数据库
# ========================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                      # 可选
QDRANT_COLLECTION=knowledge

# ========================================
# Redis 缓存
# ========================================
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=                      # 可选

# ========================================
# Neo4j 知识图谱
# ========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ========================================
# MinIO 对象存储
# ========================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=knowledge

# ========================================
# gRPC 服务配置
# ========================================
GRPC_PYTHON_ADDRESS=localhost:50051
GRPC_GO_ADDRESS=localhost:50052

# ========================================
# 服务端口
# ========================================
HTTP_PORT=8000
GRPC_PORT=50051

# ========================================
# 安全配置
# ========================================
ENABLE_TLS=false
