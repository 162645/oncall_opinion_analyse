# ========================================
# Oncall Opinion Analyse 配置文件
# ========================================
# 复制此文件为 .env 并填写实际值

# ========================================
# 环境设置
# ========================================
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ========================================
# LLM API 配置 (必填)
# ========================================
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# DeepSeek（OpenAI-compatible API）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=                    # 可选，自定义 API 地址
OPENAI_MODEL=gpt-4o

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ========================================
# ClickHouse 数据库配置 (必填)
# ========================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=net_measure
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
# src/clickhouse/client.py 使用 clickhouse-driver 原生 TCP 协议；8123/HTTPS 不是当前客户端协议

# ========================================
# Qdrant 向量数据库
# ========================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                      # 可选
QDRANT_COLLECTION=knowledge

# ========================================
# Redis 缓存
# ========================================
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=                      # 可选

# ========================================
# Neo4j 知识图谱
# ========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ========================================
# MinIO 对象存储
# ========================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=knowledge

# ========================================
# gRPC 服务配置
# ========================================
GRPC_PYTHON_ADDRESS=localhost:50051
GRPC_GO_ADDRESS=localhost:50052

# ========================================
# 服务端口
# ========================================
HTTP_PORT=8000
GRPC_PORT=50051

# ========================================
# Evidence-driven Agent Harness
# ========================================
AGENT_CHECKPOINT_BACKEND=memory
AGENT_CHECKPOINT_PREFIX=oncall_harness
AGENT_CHECKPOINT_TTL_MINUTES=1440
AGENT_MAX_ROUNDS=4
HARNESS_LLM_ENABLED=false
HARNESS_PLANNER_ENABLED=false
AGENT_TOOL_TIMEOUT_SECONDS=8

# ========================================
# 安全配置
# ========================================
ENABLE_TLS=false
